#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Row 0 (Pin 0.20) - Цифри
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                
                // Row 1 (Pin 0.22) - QWERTY
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y
                
                // Row 2 (Pin 0.24) - ASDF
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H
                
                // Row 3 (Pin 1.00) - ZXCV
                &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N
                
                // Row 4 (Pin 0.11) - Тест
                &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL
                
                // Row 5 (Pin 1.04) - Тест
                &kp LBKT &kp RBKT &kp BSLH &kp SEMI &kp APOS &kp GRAVE
                
                // Row 6 (Pin 1.06) - Великий палець (швидше за все тут)
                &kp SPACE &kp ENTER &kp LALT &kp BSPC &kp TAB &kp ESC
            >;
        };
    };
};