#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // Row 0: Цифри
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                // Row 1: QWERTY
                &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y
                // Row 2: ASDF
                &kp A  &kp S  &kp D  &kp F  &kp G  &kp H
                // Row 3: ZXCV
                &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N
                // Row 4: Thumb 1 (перевіряємо що тут)
                &kp SPACE &kp ENTER &kp LALT &kp BSPC &kp TAB &kp ESC
                // Row 5: Thumb 2 (або тут)
                &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp K_VOL_DN &kp K_VOL_UP
            >;
        };
    };
};