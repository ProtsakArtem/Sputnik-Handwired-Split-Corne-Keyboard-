/* Вставте це в scylla.keymap */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
// ЛІВА РУКА ---------------------------------------   // ПРАВА РУКА --------------------------------------
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5           &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T            &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT
&kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G            &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X  &kp C  &kp V  &kp B            &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT

// THUMB LEFT (5 кнопок)                               // THUMB RIGHT (Блок 1)
&kp LBKT  &kp RBKT &kp SPACE &kp ENTER &kp BSPC &none  &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_DN &kp PG_UP

// DUMMY ROW (Ліва)                                    // THUMB RIGHT (Блок 2)
&none     &none    &none     &none     &none    &none  &kp SPACE &kp RET  &kp HOME &kp END &kp DEL &kp RALT
            >;
        };
    };
};