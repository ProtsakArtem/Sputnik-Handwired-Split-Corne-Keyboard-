#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        /* Важливо: саме matrix-transform (з дефісом) */
        zmk,matrix-transform = &default_transform;
    };

    default_transform: default_transform {
        compatible = "zmk,matrix-transform";

        /* Логічна сітка для keymap: 5 рядків × 12 колонок */
        rows = <5>;
        columns = <12>;

        /*
         * Ліва половина (колонки 0..5):
         *   після swap у kscan: event(row) = old_col, event(col) = old_row
         *   тому для логічного (r,c) треба RC(c,r)
         *
         * Права половина (колонки 6..11):
         *   звичайно RC(r,c) але c вже з offset'ом (див. scylla_right.overlay нижче)
         */
        map = <
            /* r=0 */
            RC(0,0) RC(1,0) RC(2,0) RC(3,0) RC(4,0) RC(5,0)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            /* r=1 */
            RC(0,1) RC(1,1) RC(2,1) RC(3,1) RC(4,1) RC(5,1)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            /* r=2 */
            RC(0,2) RC(1,2) RC(2,2) RC(3,2) RC(4,2) RC(5,2)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            /* r=3 */
            RC(0,3) RC(1,3) RC(2,3) RC(3,3) RC(4,3) RC(5,3)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
            /* r=4 (thumb row у твоїй логіці) */
            RC(0,4) RC(1,4) RC(2,4) RC(3,4) RC(4,4) RC(5,4)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };
};
